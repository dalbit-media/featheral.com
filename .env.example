# Private production values stay on the server, outside Git.
CMS_PASSWORD=
# Preserve existing ledger/signing-key configuration when deploying.
# Minimal deployment settings (SFTP upload + SSH execution).
DEPLOY_TARGET=root@featheral.com:/opt/featheral
# No root password in .env. Enroll it with an origin-wallet signature in Admin.
# Generate the independent key outside this repository and all ledger backups:
# node scripts\init-db-vault.js C:\private\featheral-vault.key
DB_VAULT_KEY_FILE=
# Optional absolute journal directory; default data/file-ledgers.
DB_LEDGER_DIR=
# Alternatively use a restricted deployment user and an absolute SSH key path.
DEPLOY_KEY_FILE=
DEPLOY_HOST_KEY_SHA256=
DEPLOY_TLS_EMAIL=
DEPLOY_ENABLED=false
# Optional non-default SSH port:
DEPLOY_PORT=22

# Featheral App: generate once with the locally installed web-push library.
# node -e "console.log(require('web-push').generateVAPIDKeys())"
# Keep the private key only on the server. Missing keys explicitly disable browser push.
APP_VAPID_PUBLIC_KEY=
APP_VAPID_PRIVATE_KEY=
# Optional comma-separated STUN/TURN URLs. No external relay is used by default.
# A coturn REST shared secret generates short-lived credentials for approved insiders.
APP_ICE_URLS=
APP_TURN_SECRET=
