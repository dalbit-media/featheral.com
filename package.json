{
  "name": "featheral.com",
  "version": "1.0.0",
  "description": "Featheral Gold (FTHG) token contract and admin site",
  "main": "hardhat.config.js",
  "scripts": {
    "prestart": "node scripts/export-abi.js && npm run build:world",
    "start": "node scripts/serve.js",
    "build:world": "npm run build --prefix sites/world.featheral.com/play",
    "build:logos": "node scripts/build-site-logos.js",
    "compile": "hardhat compile",
    "abi": "node scripts/export-abi.js",
    "deploy:bridge": "node scripts/deploy-bridge.js",
    "generate:service-keys": "node services/identity/keygen.js",
    "start:cms": "npm start --prefix services/cms",
    "test:cms": "npm test --prefix services/cms",
    "test:db": "node --test services/database/tests/*.test.js",
    "test": "hardhat test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dalbit-media/featheral.com.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "workspaces": [
    "services/cms"
  ],
  "bugs": {
    "url": "https://github.com/dalbit-media/featheral.com/issues"
  },
  "homepage": "https://github.com/dalbit-media/featheral.com#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "hardhat": "^2.29.1"
  },
  "dependencies": {
    "ethers": "^6.17.0"
  }
}
