oter>\n<script src=\"/shared/site-links.js\"></script>\n<script src=\"/shared/wallet-profile.js\"></script>\n<script>FeatheralProfile.mount(document.getElementById(\"walletButton\"), { primaryCurrency: \"fthDollar\", walletUrl: FeatheralSites.url(\"dollar\", \"/wallet/\") });</script>\n</body>\n</html>"
