  "layout": "<!doctype html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"utf-8\">\r\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\r\n<title>Featheral Dollar (FTH$) · Layer-3 currency of Featheral World</title>\r\n<meta name=\"description\" content=\"Featheral Dollar (FTH$) is the layer-3 currency of Featheral World with its own native, signed block ledger, distributed as daily minified JSON files and bridged to FTHG on Ethereum Mainnet.\">\r\n<meta property=\"og:title\" content=\"Featheral Dollar (FTH$)\">\r\n<meta property=\"og:description\" content=\"Layer-3 game currency with a native, publicly replicable block ledger. Bridged to FTHG on Ethereum Mainnet.\">\r\n<meta property=\"og:image\" content=\"/shared/logo-dollar.svg\">\r\n<link rel=\"icon\" href=\"/shared/logo-dollar.svg\">\r\n<meta name=\"theme-color\" content=\"#07100c\">\r\n<link rel=\"stylesheet\" href=\"/shared/featheral.css\">\r\n<link rel=\"stylesheet\" href=\"/shared/wallet-profile.css\">\r\n</head>\r\n<body class=\"site-dollar\">\r\n<nav class=\"eco-bar\" aria-label=\"Featheral sites\"><a data-site=\"foundation\">Foundation</a><a data-site=\"gold\">Gold · FTHG</a><a data-site=\"dollar\">Dollar · FTH$</a><a data-site=\"world\">World</a></nav>\r\n<header class=\"top\">\r\n  <a class=\"brand\" href=\"/\"><img src=\"/shared/logo-dollar.svg\" alt=\"\" width=\"34\" height=\"34\"><b>Featheral Dollar</b></a>\r\n  <nav>\r\n    <a href=\"#stats\">Stats</a>\r\n    <a href=\"#how\">How it works</a>\r\n    <a href=\"#ledger\">Ledger</a>\r\n    <a href=\"/explorer/\">Explorer</a>\r\n    <a href=\"/docs/\">Docs</a>\r\n    <button id=\"walletButton\" class=\"wallet-icon\" type=\"button\" title=\"Connect wallet to see your balance and profile\" aria-label=\"Connect wallet\">\r\n      <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0 0 4h14a2 2 0 0 1 2 2v3\"/><path d=\"M3 5v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-3\"/><path d=\"M21 12h-4a2 2 0 0 0 0 4h4z\"/></svg>\r\n    </button>\r\n  </nav>\r\n</header>\r\n\r\n<main class=\"cms-document\">{{CMS_DOCUMENT}}</main>\r\n\r\n<footer>\r\n  <p>© <a data-site=\"foundation\" href=\"https://featheral.com\">Featheral Foundation</a> · <a data-site=\"gold\" href=\"https://gold.featheral.com\">Featheral Gold</a> · <a data-site=\"world\" href=\"https://world.featheral.com\">Featheral World</a></p>\r\n  <p class=\"muted fine\">FTH$ is an in-game currency on the Featheral Dollar layer-3 ledger. It is not an ERC-20, not a stablecoin, and not redeemable for US dollars. USD figures derive from the internal $0.01/FTHG reference estimate and the bridge rate; they are not a market price or offer.</p>\r\n</footer>\r\n<script src=\"/shared/site-links.js\"></script>\r\n<script src=\"/shared/wallet-profile.js\"></script>\r\n<script src=\"/fth.js\"></script>\r\n<script src=\"/landing.js\"></script>\r\n</body>\r\n</html>\r\n"
