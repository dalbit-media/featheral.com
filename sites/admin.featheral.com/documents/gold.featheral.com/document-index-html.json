  "layout": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Featheral Gold (FTHG) · Utility token of Featheral World</title>\n<meta name=\"description\" content=\"Featheral Gold (FTHG) is the fixed-supply utility token of Featheral World. 216,265,000 FTHG — one per kilogram of the world's above-ground gold — exchangeable for in-game Featheral Dollars (FTH$).\">\n<meta property=\"og:title\" content=\"Featheral Gold (FTHG)\">\n<meta property=\"og:description\" content=\"Fixed-supply ERC-20 on Ethereum Mainnet powering the Featheral World game economy.\">\n<meta property=\"og:image\" content=\"/shared/logo-gold.svg\">\n<link rel=\"icon\" href=\"/shared/logo-gold.svg\">\n<meta name=\"theme-color\" content=\"#0f0d07\">\n<link rel=\"stylesheet\" href=\"/shared/featheral.css\">\n<link rel=\"stylesheet\" href=\"/shared/wallet-profile.css\">\n<link rel=\"stylesheet\" href=\"/reserve.css\">\n</head>\n<body class=\"site-gold\">\n<nav class=\"eco-bar\" aria-label=\"Featheral sites\"><a data-site=\"foundation\">Foundation</a><a data-site=\"gold\">Gold · FTHG</a><a data-site=\"dollar\">Dollar · FTH$</a><a data-site=\"world\">World</a></nav>\n<header class=\"top gold-header\">\n  <a class=\"brand\" href=\"/\"><img src=\"/shared/logo-gold.svg\" alt=\"\" width=\"34\" height=\"34\"><b>Featheral Gold</b></a>\n  <nav>\n    <a href=\"/\" aria-current=\"page\">Overview</a>\n    <a href=\"/conversion/\">Conversion</a>\n    <a href=\"/admin/\">Admin</a>\n    <a href=\"/docs/\">Docs</a>\n    <button id=\"walletButton\" class=\"wallet-icon\" type=\"button\" title=\"Connect wallet to see your balance and profile\" aria-label=\"Connect wallet\">\n      <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0 0 4h14a2 2 0 0 1