# Copy into a protected runtime environment; never commit private keys.
HOST=127.0.0.1
PORT=8080

# Finite-origin reserve: disabled by default. "live" requires an authorized zero-supply ledger and backup.
# Live activation appends a signed policy block without rewriting the existing genesis or game saves.
# It enables off-chain market funding only; no Ethereum transactions are submitted.
GOLD_RESERVE_MODE=disabled
# In isolated mode set a separate port and a named, empty directory under data/reserve-tests.
GOLD_RESERVE_TEST_DIR=
# Example: PORT=18087, GOLD_RESERVE_MODE=isolated,
# GOLD_RESERVE_TEST_DIR=.\data\reserve-tests\trial-01, APP_ORIGIN=http://world.localhost:18087

# FTH$ layer-3 ledger. Use "writer" on exactly one node and "reader" on replicas.
# "unconfigured" runs a standalone local writer for development.
FTH_LEDGER_MODE=unconfigured
FTH_LEDGER_NODE_ID=local-node
# Daily minified JSON block files are written to <DIR>/YYYY/YYYY-MM-DD.jsonl.
FTH_LEDGER_DIR=./data/fth-ledger/local-node
# Pending transactions are sealed into one block after this delay (0 = next tick).
FTH_LEDGER_BLOCK_INTERVAL_MS=1000
# Readers only: public base URL of the writer and the polling interval for /api/v1/fth/sync.
FTH_LEDGER_UPSTREAM_URL=
FTH_LEDGER_SYNC_INTERVAL_MS=5000
# Writer: Ed25519 PKCS#8 PEM used to sign every block hash.
FTH_LEDGER_SIGNING_PRIVATE_KEY=
# Readers: the writer's Ed25519 SPKI PEM; unsigned or mis-signed blocks are rejected.
FTH_LEDGER_WRITER_PUBLIC_KEY=

# Ethereum Mainnet access for FTHG reads and bridge event ingestion (FTHG has no local ledger).
TOKEN_API_RPC_URL=https://ethereum-rpc.publicnode.com
TOKEN_API_BRIDGE_ADDRESS=
TOKEN_API_CONFIRMATIONS=12
TOKEN_API_REDEMPTION_CANCEL_GRACE_MS=1800000
TOKEN_API_CORS_ORIGINS=
TOKEN_API_GAME_SERVICE_ADDRESS=

# JSON object: serviceId -> { "role": "game", "publicKey": "<PEM>" }.
# Register public keys only. Keep the corresponding private keys in each service's secret manager.
TOKEN_API_SERVICES_JSON={}

# Admin consoles (/admin/ on every site). Comma-separated wallet addresses; also act as World moderators.
FEATHERAL_ADMIN_WALLETS=
WORLD_MODERATORS=

# World communication ledger: a separate hash-chained ledger of signed social actions (same engine as FTH$).
WORLD_LEDGER_MODE=unconfigured
WORLD_LEDGER_NODE_ID=local-node
WORLD_LEDGER_DIR=./data/world-ledger/local-node
WORLD_LEDGER_BLOCK_INTERVAL_MS=1000
WORLD_LEDGER_UPSTREAM_URL=
WORLD_LEDGER_SYNC_INTERVAL_MS=5000
WORLD_LEDGER_SIGNING_PRIVATE_KEY=
WORLD_LEDGER_WRITER_PUBLIC_KEY=
